<?xml version="1.0" encoding="utf-8"?>
<!--Description: Account creation Activity xml layout
Notes: Color Scheme updated
Author: Rain Haque
Documentor: Rion Miyazaki-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:backgroundTint="@color/cream">

    <LinearLayout
        android:orientation="vertical"
        android:padding="60dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:backgroundTint="@color/cream">

        <TextView
            android:text="Create a new account"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#7C444F"/>

        <EditText
            android:id="@+id/etLastName"
            android:hint="Last Name"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#7C444F"
            android:textColor="@color/dark_rose"/>

        <EditText
            android:id="@+id/etUsername"
            android:hint="Preferred Username"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#7C444F"
            android:textColor="@color/dark_rose"/>

        <EditText
            android:id="@+id/etEmail"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#7C444F"
            android:textColor="@color/dark_rose"/>

        <EditText
            android:id="@+id/etPassword"
            android:hint="Create Password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#7C444F"
            android:textColor="@color/dark_rose"/>

        <EditText
            android:id="@+id/etConfirm"
            android:hint="Confirm Password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#7C444F"
            android:textColor="@color/dark_rose"/>

        <Button
            android:id="@+id/btnCreate"
            android:layout_width="207dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/rose"
            android:padding="10dp"
            android:text="Create an account" />

    </LinearLayout>
</ScrollView>

